**/node_modules
**/dist
**/.terraform
**/*.tfstate*
**/*.log
.git
.github
.env
.env.*
.local
coverage
web/test-results
web/playwright-report
docs
infra
!infra/keycloak/platform.ts
deploy
!deploy/docker-entrypoint.sh
*.md
!web/**/*.md
Dockerfile
.dockerignore
renovate.json
.sops.yaml
