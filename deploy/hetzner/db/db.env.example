# Werte der DB-VM ohne Geheimnisse (Vorlage für db.env neben compose.yaml)
# Private Adresse der DB-VM (Ausgabe db_private_ip von infra/hetzner)
DB_PRIVATE_IP=10.20.1.20
# Bucket in Hetzner Object Storage (von Hand anlegen, deploy/hetzner/README.md)
PGBACKREST_REPO1_S3_BUCKET=ppm-pgbackrest
PGBACKREST_REPO1_S3_ENDPOINT=fsn1.your-objectstorage.com
PGBACKREST_REPO1_S3_REGION=fsn1
