# Sicherung mit pgBackRest (%i = full oder diff), ausgelöst von ppm-backup@full.timer bzw. ppm-backup@diff.timer.
# Installation: Dateien nach /etc/systemd/system, dann «systemctl enable --now ppm-backup@full.timer ppm-backup@diff.timer»
[Unit]
Description=PPM: Sicherung der Datenbank (%i)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
ExecStart=/opt/ppm-db/backup.sh %i
