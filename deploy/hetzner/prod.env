# Produktion auf der App-VM bei Hetzner, OHNE Geheimnisse (Geheimnisse: deploy/hetzner/secrets/app.enc.yaml).
# Der Workflow «Deploy» überträgt diese Datei als /opt/ppm/prod.env; das Image setzt rollout.sh (PPM_IMAGE per Digest).
# Platzhalter <…> verhindern den Deploy, bis sie ersetzt sind.
# Alle Variablen: docs/konfiguration.md.

# --- Compose (Interpolation)
PPM_DOMAIN=ppm.project-suite.ch
ACME_EMAIL=<e-mail-adresse des betriebs für ACME>
PPM_SECRETS_DIR=./secrets
PPM_STATE_DIR=./state

# --- Allgemein
NODE_ENV=production
PUBLIC_BASE_URL=https://ppm.project-suite.ch
LOG_LEVEL=info

# --- Datenbank (Verbindungen als Geheimnisse; TLS mit privater CA über db_ca.crt)
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=20

# --- Anmeldung (Keycloak, Realm ppm)
OIDC_ISSUER_URL=https://id.project-suite.ch/realms/ppm
OIDC_BFF_CLIENT_ID=ppm-platform
KEYCLOAK_MGMT_CLIENT_ID=ppm-admin
KEYCLOAK_SYNC_CLIENT_ID=ppm-sync
# Entra-App der Plattform (optional, dann ENTRA_CLIENT_SECRET_FILE in compose.prod.yaml ergänzen)
#ENTRA_CLIENT_ID=

# --- HTTP (hinter Caddy)
TRUST_PROXY=1

# --- MCP (Profil mcp)
MCP_PUBLIC_URL=https://ppm.project-suite.ch/mcp
MCP_CLIENT_ID=ppm-mcp

# --- Betrieb
SHARED_STATE=postgres
METRICS_ENABLED=true
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
