# Vorlage der Geheimnisse (verschlüsselt als deploy/hetzner/secrets.sops.yaml einchecken):
#   cp deploy/hetzner/secrets.sops.yaml.example deploy/hetzner/secrets.sops.yaml
#   (Werte eintragen) && sops --encrypt --in-place deploy/hetzner/secrets.sops.yaml
# Abschnitt «app»: je Schlüssel eine Datei unter /opt/ppm/secrets auf der App-VM (compose.prod.yaml › secrets).
# Abschnitt «db»: Werte für deploy/hetzner/db/setup.sh (DB-VM).
app:
  database_url: postgres://ppm_runtime:PASSWORT@db.ppm.internal:5432/ppm
  database_worker_url: postgres://ppm_worker:PASSWORT@db.ppm.internal:5432/ppm
  database_admin_url: postgres://ppm_owner:PASSWORT@db.ppm.internal:5432/ppm
  database_ca: |
    -----BEGIN CERTIFICATE-----
    (ca.crt der DB-VM)
    -----END CERTIFICATE-----
  session_secret: (mind. 32 Zeichen, openssl rand -base64 48)
  encryption_keys: k1:(openssl rand -base64 32)
  oidc_bff_private_key: |
    (PEM aus ~/.identity/ppm/ppm-platform.pem)
  keycloak_mgmt_private_key: |
    (PEM aus ~/.identity/ppm/ppm-admin.pem)
  # nur Worker: Mailserver für MAIL_ADAPTER=smtp (smtps://konto%40example.ch:PASSWORT@mail.example.ch:465); leer bei «aus»
  smtp_url: ""
  keycloak_sync_private_key: |
    (PEM aus ~/.identity/ppm/ppm-sync.pem)
  mcp_private_key: |
    (PEM aus ~/.identity/ppm/ppm-mcp.pem)
  mcp_dpop_key: |
    (EC P-256 PEM, openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256)
db:
  OWNER_PW: (zufällig)
  RUNTIME_PW: (zufällig)
  WORKER_PW: (zufällig)
  PGBR_S3_KEY: (S3-Zugang Object Storage, Bucket ppm-pgbackrest)
  PGBR_S3_SECRET: (…)
  PGBR_CIPHER: (openssl rand -base64 48)
