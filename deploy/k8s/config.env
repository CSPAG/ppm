NODE_ENV=production
PUBLIC_BASE_URL=https://ppm.project-suite.ch
LOG_LEVEL=info
DATABASE_SSL=verify-full
OIDC_ISSUER_URL=https://id.project-suite.ch/realms/ppm
OIDC_BFF_CLIENT_ID=ppm-platform
KEYCLOAK_MGMT_CLIENT_ID=ppm-admin
KEYCLOAK_SYNC_CLIENT_ID=ppm-sync
TRUST_PROXY=1
MCP_PUBLIC_URL=https://ppm.project-suite.ch/mcp
MCP_API_URL=http://ppm-api:8080
MCP_CLIENT_ID=ppm-mcp
SHARED_STATE=postgres
METRICS_ENABLED=true
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
WEB_DIST_DIR=/app/web/dist
