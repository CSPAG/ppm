# Variablen ohne Geheimnis für compose.prod.yaml (als prod.env neben die Compose-Datei legen).
# Geheimnisse NIE hier, sondern als Dateien unter ./secrets/ (SOPS, deploy/hetzner/README.md).
# Vollständige Liste mit Beschreibung: docs/konfiguration.md.

NODE_ENV=production
PUBLIC_BASE_URL=https://ppm.project-suite.ch
OIDC_ISSUER_URL=https://identity.project-suite.ch/realms/ppm

# Datenbank (DB-VM im privaten Netz, TLS mit Prüfung des Zertifikats)
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=20

# Verwaltung und Abgleich (Schlüssel als Secret-Dateien)
KEYCLOAK_MGMT_CLIENT_ID=ppm-admin
KEYCLOAK_SYNC_CLIENT_ID=ppm-sync

# E-Mail: aus, bis ein Mailserver eingerichtet ist; für smtp das Secret smtp_url füllen (SOPS). MAIL_FROM und SMTP_URL_FILE
# bekommt nur der Worker (compose.prod.yaml)
MAIL_ADAPTER=aus

# MCP
MCP_PUBLIC_URL=https://ppm.project-suite.ch/mcp
MCP_API_URL=http://api:8080

# Betrieb
HTTP_PORT=8080
MCP_PORT=8081
OPS_PORT=9090
TRUST_PROXY=1
SHARED_STATE=postgres
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=25s
METRICS_ENABLED=true
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.ch
# OTEL_SERVICE_NAME wird je Prozess gesetzt (ppm-api, -worker, -mcp)
