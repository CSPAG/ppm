{
  "$schema": "./node_modules/@vollholz/iam-testkit/schema/identity-app.schema.json",
  "product": "ppm",
  "displayName": "PPM",
  "publicBaseUrl": "https://ppm.project-suite.ch",
  "keycloakUrl": "https://identity.project-suite.ch",
  "realm": {
    "entra": true,
    "m2m": true,
    "mcp": true,
    "smtp": {
      "host": "mail.infomaniak.com",
      "port": 587,
      "starttls": true,
      "ssl": false,
      "from": "noreply@project-suite.ch",
      "fromDisplayName": "PPM",
      "user": "noreply@project-suite.ch"
    },
    "theme": "identity",
    "themeTexts": "infra/keycloak/theme-texts.json",
    "localization": "infra/keycloak/localization.json",
    "entraDenyMessage": "Ihr Microsoft-Konto ist für diese Organisation nicht freigeschaltet. Bitte wenden Sie sich an die Administration Ihrer Organisation.",
    "machineClients": {
      "ppm-rauchtest": {
        "name": "Rauchtest",
        "description": "Rauchtest nach dem Rollout (scripts/smoke.ts); privater Schlüssel in infra/keycloak/keys/ppm-rauchtest.sops.yaml",
        "organizations": [
          "solutions"
        ],
        "scopes": [
          "ppm:read"
        ]
      }
    }
  },
  "paths": {
    "model": "src/authz/model.ts",
    "migrations": "db/migrations"
  },
  "state": {
    "bucket": "ppm-tofu-state",
    "region": "nbg1",
    "endpoint": "https://nbg1.your-objectstorage.com"
  },
  "operators": [
    {
      "email": "platform-admin@project-suite.ch"
    }
  ],
  "organizations": [
    {
      "alias": "solutions",
      "name": "Solutions",
      "admins": [
        {
          "email": "andre.h@bluewin.ch"
        }
      ]
    }
  ]
}
