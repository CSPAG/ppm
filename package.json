{
  "name": "ppm",
  "version": "0.1.0",
  "private": true,
  "description": "PPM – Strategieumsetzung und Projektportfoliomanagement, mandantenfähig",
  "type": "module",
  "engines": { "node": ">=24", "npm": ">=11" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src web/src --config .dependency-cruiser.cjs && node scripts/check-network.ts && node scripts/check-address.ts",
    "test": "node scripts/test.ts",
    "web:install": "npm ci --prefix web",
    "web:check": "npm run check --prefix web",
    "web:build": "npm run build --prefix web",
    "check": "npm run typecheck && npm run arch && npm test && npm run web:check",
    "dev:env": "node scripts/dev-env.ts",
    "dev:up": "docker compose --env-file .env -f deploy/compose.dev.yaml up -d --wait",
    "dev:down": "docker compose --env-file .env -f deploy/compose.dev.yaml down",
    "dev:setup": "npm run dev:env && npm run dev:up && npm run db:migrate && npm run keycloak:setup",
    "dev:api": "node --env-file=.env --import ./src/platform/ops/preload.ts src/platform/main/api.ts",
    "dev:worker": "node --env-file=.env --import ./src/platform/ops/preload.ts src/platform/main/worker.ts",
    "dev:mcp": "node --env-file=.env --import ./src/platform/ops/preload.ts src/platform/main/mcp.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
    "keycloak:setup": "node --env-file=.env scripts/keycloak-setup.ts",
    "seed:demo": "node --env-file=.env scripts/seed-demo.ts",
    "tenant": "node --env-file-if-exists=.env scripts/tenant-admin.ts",
    "rotate-keys": "node --env-file-if-exists=.env scripts/rotate-encryption-keys.ts",
    "env:docs": "node scripts/env-docs.ts",
    "openapi:export": "node scripts/openapi-export.ts",
    "api:types": "npm run openapi:export && npm run api:types --prefix web",
    "e2e": "node scripts/e2e-db.ts && npm run e2e --prefix web",
    "smoke": "node --env-file=.env scripts/smoke.ts",
    "identity:conformity": "iam-conformity-test",
    "identity:platform-json": "node infra/keycloak/platform.ts > infra/keycloak/platform.json",
    "identity:first-org": "iam-org-bootstrap --manifest identity.app.json",
    "identity:sync": "create-iam-app sync"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sinclair/typebox": "0.34.52",
    "@vollholz/iam": "3.0.0",
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vollholz/create-iam-app": "0.2.0",
    "@vollholz/iam-testkit": "2.0.0",
    "dependency-cruiser": "18.6.0",
    "typescript": "5.9.3"
  }
}
