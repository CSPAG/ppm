{
  "name": "ppm",
  "version": "0.1.0",
  "private": true,
  "description": "PPM – Strategieumsetzung und Projektportfoliomanagement, mandantenfähig",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src web/src --config .dependency-cruiser.cjs && node scripts/check-network.ts && node scripts/check-address.ts",
    "test": "node scripts/test.ts",
    "check": "npm run typecheck && npm run arch && npm test && npm run web:check",
    "dev:env": "node scripts/dev-env.ts",
    "dev:up": "docker compose --env-file .env -f deploy/compose.dev.yaml up -d --wait",
    "dev:down": "docker compose --env-file .env -f deploy/compose.dev.yaml down",
    "dev:setup": "npm run dev:env && npm run dev:up && npm run db:migrate && npm run keycloak:setup",
    "dev:api": "node --env-file-if-exists=.env src/cli.ts api",
    "dev:worker": "node --env-file-if-exists=.env src/cli.ts worker",
    "dev:mcp": "node --env-file-if-exists=.env src/cli.ts mcp",
    "db:migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "keycloak:setup": "node --env-file-if-exists=.env scripts/keycloak-setup.ts",
    "env:docs": "node scripts/env-docs.ts",
    "openapi:export": "node scripts/openapi-export.ts",
    "api:types": "npm --prefix web run api:types",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "tenant": "node --env-file-if-exists=.env src/cli.ts tenant",
    "rotate-keys": "node --env-file-if-exists=.env src/cli.ts rotate-keys",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "web:install": "npm --prefix web ci",
    "web:check": "npm --prefix web run check",
    "web:build": "npm --prefix web run build",
    "web:size": "node scripts/check-bundle.ts",
    "e2e": "sh scripts/e2e.sh",
    "identity:conformity": "iam-conformity-test",
    "identity:platform-json": "node infra/keycloak/platform.ts > infra/keycloak/platform.json",
    "identity:first-org": "iam-org-bootstrap --manifest identity.app.json",
    "identity:sync": "create-iam-app sync"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@sinclair/typebox": "0.34.52",
    "@vollholz/iam": "5.0.3",
    "@vollholz/platform": "0.7.0",
    "fastify": "5.12.6",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vollholz/create-iam-app": "0.5.5",
    "@vollholz/iam-testkit": "2.4.5",
    "dependency-cruiser": "18.6.0",
    "typescript": "5.9.3"
  }
}
